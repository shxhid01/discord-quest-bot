# Required. ~72 chars, no "Bot " prefix.
DQUEST_TOKEN=

# Behaviour
DQUEST_CLAIM=true
# DQUEST_CONCURRENCY=2 # Optional: limit simultaneous quests (default: all)
DQUEST_MAX_ATTEMPTS=1
DQUEST_MAX_CYCLES=2

# Comma-separated quest ids to never touch
DQUEST_BLACKLIST=

# Files (paths inside the container are set in the Dockerfile)
DQUEST_STATE_DIR=./data
DQUEST_LOG_FILE=./data/orion.log